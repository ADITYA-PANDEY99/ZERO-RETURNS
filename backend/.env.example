# ── Supabase (optional — app works with in-memory fallback if not set) ──
# Get from: https://supabase.com → Project Settings → API
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_key

# ── Groq LLM (optional — chatbot uses rule-based fallback if not set) ──
# Get free key from: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# ── App security (CHANGE before any production deployment) ──
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_secret_key_here

# ── Server config ──
FRONTEND_URL=http://localhost:5173
ENVIRONMENT=development
PORT=8000
